# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cinderella:cinderella@localhost:5432/cinderella

# ── Amazon scraping ───────────────────────────────────────────────────────────
# Delay between requests in seconds (randomised between min and max)
AMAZON_REQUEST_DELAY_MIN=2.0
AMAZON_REQUEST_DELAY_MAX=5.0
# Maximum books to harvest per bestseller category page
AMAZON_MAX_BOOKS_PER_CATEGORY=100
# Run Playwright browser headless (true/false)
AMAZON_HEADLESS=true
# Optional: path to a Chromium user-data directory to reuse cookies/session
AMAZON_USER_DATA_DIR=

# ── Collection schedule ───────────────────────────────────────────────────────
# Standard cron expression (default: 06:00 every day)
COLLECTION_SCHEDULE=0 6 * * *

# ── Alerts (wired in Milestone 2+) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Output ────────────────────────────────────────────────────────────────────
REPORTS_DIR=./reports

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Leave blank to log to stdout only
LOG_FILE=

# ── Reddit API (required for Reddit collector) ────────────────────────────────
# Register at https://www.reddit.com/prefs/apps → "script" app type
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=cinderella-bot/1.0 (by /u/your_reddit_username)

# ── Social signal scraping ────────────────────────────────────────────────────
GOODREADS_HEADLESS=true
TIKTOK_HEADLESS=true
TIKTOK_MAX_BOOKS=100
